{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rescue Host Source Tests",
  "version": "0.1.0",
  "identifier": "com.o2connective.rescue-host.shell",
  "build": {
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "resident-source-tests",
          "description": "Explicit source-test IPC context, never selected by normal run.",
          "local": true,
          "windows": [
            "main"
          ],
          "permissions": [
            "allow-shell-status",
            "allow-resident-port"
          ]
        }
      ],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../icons/icon.png",
      "../../icons/icon.ico"
    ]
  }
}
