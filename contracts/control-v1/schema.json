{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rescue-host:control:1",
  "title": "rescue-host-control/1 implementation candidate",
  "$comment": "Decoded-object shape only. Raw UTF-8, duplicate keys, JSONL byte/depth limits and transport state require codec/state validation. Not authentication or permission to activate.",
  "oneOf": [
    {
      "allOf": [
        {
          "$ref": "#/$defs/bootstrapBase"
        },
        {
          "properties": {
            "kind": {
              "const": "hello"
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/bootstrapBase"
        },
        {
          "properties": {
            "kind": {
              "const": "hello_ack"
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/controlBase"
        },
        {
          "properties": {
            "kind": {
              "const": "start"
            },
            "payload": {
              "$ref": "#/$defs/startPayload"
            }
          },
          "required": [
            "requestId"
          ]
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/controlBase"
        },
        {
          "properties": {
            "kind": {
              "const": "snapshot"
            },
            "payload": {
              "$ref": "#/$defs/emptyPayload"
            }
          },
          "required": [
            "requestId"
          ]
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/controlBase"
        },
        {
          "properties": {
            "kind": {
              "const": "stop"
            },
            "payload": {
              "$ref": "#/$defs/emptyPayload"
            }
          },
          "required": [
            "requestId"
          ]
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/controlBase"
        },
        {
          "properties": {
            "kind": {
              "const": "receipt"
            },
            "payload": {
              "$ref": "#/$defs/receiptPayload"
            }
          },
          "required": [
            "requestId"
          ]
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/controlBase"
        },
        {
          "properties": {
            "kind": {
              "const": "snapshot_result"
            },
            "payload": {
              "$ref": "#/$defs/snapshotPayload"
            }
          },
          "required": [
            "requestId"
          ]
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/controlBase"
        },
        {
          "properties": {
            "kind": {
              "const": "error"
            },
            "payload": {
              "$ref": "#/$defs/errorPayload"
            }
          },
          "required": [
            "requestId"
          ]
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "#/$defs/controlBase"
        },
        {
          "properties": {
            "kind": {
              "const": "state_changed"
            },
            "payload": {
              "$ref": "#/$defs/snapshotPayload"
            }
          },
          "not": {
            "required": [
              "requestId"
            ]
          }
        }
      ]
    }
  ],
  "$defs": {
    "u64": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "description": "Canonical unsigned 64-bit decimal string; no rounding.",
      "minLength": 1,
      "maxLength": 20,
      "not": {
        "pattern": "[^0-9]"
      }
    },
    "positiveU64": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "minLength": 1,
      "maxLength": 20,
      "not": {
        "pattern": "[^0-9]"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      }
    },
    "generation": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "minLength": 32,
      "maxLength": 32,
      "not": {
        "pattern": "[^0-9a-f]"
      }
    },
    "identity": {
      "type": "object",
      "properties": {
        "launchId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          }
        },
        "epoch": {
          "$ref": "#/$defs/u64"
        },
        "policyDigest": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "launchId",
        "epoch",
        "policyDigest"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "artifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "channelNonce": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "artifactSha256",
        "channelNonce"
      ],
      "additionalProperties": false
    },
    "bootstrapBase": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "rescue-host-control/1"
        },
        "kind": {
          "type": "string"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        }
      },
      "required": [
        "protocol",
        "kind",
        "generation",
        "identity",
        "binding"
      ],
      "additionalProperties": false
    },
    "controlBase": {
      "type": "object",
      "properties": {
        "protocol": {
          "const": "rescue-host-control/1"
        },
        "kind": {
          "type": "string"
        },
        "generation": {
          "$ref": "#/$defs/generation"
        },
        "sequence": {
          "$ref": "#/$defs/positiveU64"
        },
        "requestId": {
          "$ref": "#/$defs/positiveU64"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "protocol",
        "kind",
        "generation",
        "sequence",
        "identity",
        "payload"
      ],
      "additionalProperties": false
    },
    "emptyPayload": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "startPayload": {
      "type": "object",
      "properties": {
        "policyRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          }
        }
      },
      "required": [
        "policyRef"
      ],
      "additionalProperties": false
    },
    "receiptPayload": {
      "type": "object",
      "properties": {
        "operation": {
          "enum": [
            "start",
            "stop"
          ]
        },
        "accepted": {
          "const": true
        }
      },
      "required": [
        "operation",
        "accepted"
      ],
      "additionalProperties": false
    },
    "snapshotPayload": {
      "type": "object",
      "properties": {
        "goState": {
          "enum": [
            "prepared",
            "ready",
            "active",
            "revoking",
            "terminated"
          ]
        },
        "pending": {
          "$ref": "#/$defs/u64"
        },
        "active": {
          "$ref": "#/$defs/u64"
        },
        "owned": {
          "$ref": "#/$defs/u64"
        },
        "goCloseConfirmed": {
          "type": "boolean"
        }
      },
      "required": [
        "goState",
        "pending",
        "active",
        "owned",
        "goCloseConfirmed"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "goCloseConfirmed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "goState": {
                "const": "terminated"
              }
            }
          }
        }
      ]
    },
    "errorPayload": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "VERSION_MISMATCH",
            "INVALID_MESSAGE",
            "CONTEXT_MISMATCH",
            "REQUEST_REJECTED",
            "DEADLINE_EXCEEDED",
            "TERMINATION_UNCONFIRMED"
          ]
        },
        "retryable": {
          "const": false
        },
        "goCloseConfirmed": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable",
        "goCloseConfirmed"
      ],
      "additionalProperties": false
    }
  }
}
